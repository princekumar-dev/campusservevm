# Local Development Environment Variables for MSEC CampusServe

# Development
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/campusserve

# Server
PORT=3001
PUBLIC_BASE_URL=http://localhost:3000

# JWT
JWT_SECRET=replace_with_a_long_random_secret
PO_QR_SECRET=replace_with_a_different_long_random_secret
EMAIL_VERIFICATION_SECRET=replace_with_a_third_long_random_secret

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Reverse proxy/runtime settings
HOST=127.0.0.1
TRUST_PROXY_HOPS=1
FORCE_HTTPS=false
MAX_REQUEST_SIZE_MB=10

# Evolution API Configuration (WhatsApp Messaging)
EVOLUTION_API_URL=https://your-evolution-service.example.com
EVOLUTION_API_KEY=replace_with_your_evolution_api_key
EVOLUTION_INSTANCE_NAME=campusserve-notifications

# Web Push
VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key

# Optional email provider (configure Resend or SMTP)
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional bootstrap account. Leave both empty to disable automatic creation.
SERVICE_PORTAL_EMAIL=
SERVICE_PORTAL_PASSWORD=
SERVICE_PORTAL_PHONE=
