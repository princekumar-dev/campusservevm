NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_HOPS=1
FORCE_HTTPS=true
MAX_REQUEST_SIZE_MB=10

MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER/Campusserve?retryWrites=true&w=majority"
DNS_SERVERS=
JWT_SECRET=GENERATE_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
PO_QR_SECRET=GENERATE_A_DIFFERENT_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
EMAIL_VERIFICATION_SECRET=GENERATE_A_THIRD_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

FRONTEND_URL=https://campusserve.example.edu
PUBLIC_BASE_URL=https://campusserve.example.edu
ALLOWED_ORIGINS=https://campusserve.example.edu

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.edu

RESEND_API_KEY=
RESEND_FROM="CampusServe <noreply@example.edu>"
SMTP_HOST=
SMTP_PORT=587
SMTP_REQUIRE_TLS=true
SMTP_FORCE_IPV4=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusServe <noreply@example.edu>"

# Optional. Set both to create the service-provider account when absent.
SERVICE_PORTAL_EMAIL=
SERVICE_PORTAL_PASSWORD=
SERVICE_PORTAL_PHONE=

GATE_LATITUDE=
GATE_LONGITUDE=
GATE_MAX_ACCURACY_METERS=100
GATE_BOUNDARY_BUFFER_METERS=50
SERVICE_PO_BOUNDARY_BUFFER_METERS=50
