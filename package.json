{
  "name": "msec-campusserve",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "node build.js",
    "convert-images": "node scripts/convert-images.js",
    "build:ci": "ENABLE_COMPRESSION=true npm run build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "server": "node server.js",
    "server:dev": "node --watch server.js",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "warm-tunnel": "node scripts/warm-tunnel.js",
    "dev:warm": "concurrently \"npm run server:dev\" \"npm run dev\" \"npm run warm-tunnel\"",
    "seed-users": "node seed-users.js",
    "ensure-super-admin": "node scripts/ensure-super-admin.js",
    "ensure-gate-service-users": "node scripts/ensure-gate-service-users.js",
    "migrate:mongo-to-postgres": "node scripts/migrate-mongo-to-postgres.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lru-cache": "^11.2.2",
    "lucide-react": "^0.553.0",
    "mongoose": "^8.24.3",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "react-window": "^1.8.7",
    "recharts": "^3.9.2",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.22",
    "concurrently": "^7.6.0",
    "esbuild": "^0.28.2",
    "jsdom": "^23.0.1",
    "postcss": "^8.5.6",
    "regenerator-runtime": "^0.13.9",
    "tailwindcss": "^3.4.18",
    "terser": "^5.46.0",
    "vite": "^8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10"
  }
}
